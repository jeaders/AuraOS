From: AuraOS Team <team@auraos.dev>
Subject: [PATCH] Add AuraOS branding to kernel

This patch adds AuraOS branding to the Linux kernel.

diff --git a/Makefile b/Makefile
index 1234567..abcdefg 100644
--- a/Makefile
+++ b/Makefile
@@ -1,4 +1,4 @@
-VERSION = 6
+PATCHLEVEL = 1
-SUBLEVEL = 0
-EXTRAVERSION =
-NAME = ...
+PATCHLEVEL = 0
+EXTRAVERSION = -auraos
+NAME = AuraOS

diff --git a/init/version.c b/init/version.c
index 1234567..abcdefg 100644
--- a/init/version.c
+++ b/init/version.c
@@ -1,3 +1,3 @@
-const char linux_banner[] =
+const char auraos_banner[] =
-	"Linux version %s (%s@%s) (%s) %s\n";
+	"AuraOS version %s (%s@%s) (%s) %s\n";
